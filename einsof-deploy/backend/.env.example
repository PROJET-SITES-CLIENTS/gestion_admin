# EINSOF ERP — Exemple de configuration backend
# Copier ce fichier en backend/.env puis renseigner les valeurs.

# Secret de signature des JWT (OBLIGATOIRE, >= 32 caractères).
# Générer : php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# Durée de vie des tokens (heures)
JWT_TTL_HOURS=12

# Mot de passe du compte admin initial (créé seulement si db.json n'existe pas)
ADMIN_PASSWORD=

# Taille maximale des uploads (Mo)
MAX_UPLOAD_MB=10

# Origines CORS autorisées (CSV). VIDE = same-origin uniquement.
CORS_ALLOWED_ORIGINS=

# Chemins optionnels pour hébergement mutualisé (données hors docroot) :
# DB_FILE=/home/compte/private/db.json
# UPLOADS_DIR=/home/compte/private/uploads
